<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (CaptureWidgetProvider, REQ-001, DD-019), wide variant, shown when the
     widget is made wider: the glyph plus a hint, a bar as high as the Offload bar in the middle
     of the cell (PO 06-10-2026). The whole bar is the button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_height"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_background"
        android:clipToOutline="true"
        android:contentDescription="@string/widget_button"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/widget_icon_well"
            android:minWidth="48dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:layout_marginHorizontal="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_capture"
                android:tint="@color/widget_glyph" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/widget_hint"
            android:textColor="@color/widget_hint"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
