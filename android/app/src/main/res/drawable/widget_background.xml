<?xml version="1.0" encoding="utf-8"?>
<!-- Background of the capture widget (DD-019): the navy tile of the app icon, with the system
     widget corner radius so it matches other widgets. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/widget_background_bottom"
        android:startColor="@color/widget_background_top" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
