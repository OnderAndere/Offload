# Normalise line endings to LF in the repository and working copy
# (Dart/Flutter tooling and `dart format` expect LF).
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
